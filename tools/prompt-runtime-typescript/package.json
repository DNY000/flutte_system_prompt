{
  "name": "prompt-runtime-typescript",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/skills.test.js dist/router.test.js dist/execution-policy.test.js dist/artifact-verifier.test.js",
    "validate-manifest": "npm run build && node dist/validate-manifest.js",
    "verify-artifacts": "npm run build && node dist/verify-artifacts.js"
  },
  "devDependencies": {
    "@types/node": "~22.19.17",
    "typescript": "~6.0.2"
  }
}
